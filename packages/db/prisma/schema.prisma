generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String               @id @default(uuid()) @db.Uuid
  authSubject     String               @unique
  fullName        String
  email           String               @unique
  createdAt       DateTime             @default(now()) @map("created_at")
  passwordHash    String?              @map("password_hash")
  gymUsers        GymUser[]
  notes           MemberNote[]         @relation("NoteAuthor")
  payments        Payment[]            @relation("PaymentRecorder")
  sessions        Session[]
  passwordResets  PasswordResetToken[]
  memberImports   MemberImport[]
  leadActivities  LeadActivity[]       @relation("LeadActivityAuthor")
  assignedLeads   Lead[]               @relation("LeadAssignee")
  sentInvites     GymInvite[]          @relation("InviteSender")
  acceptedInvites GymInvite[]          @relation("InviteAcceptor")
  signupInvites   GymSignupInvite[]    @relation("SignupInviteCreator")
  campaigns       Campaign[]           @relation("CampaignCreator")
  campaignSends   CampaignRecipient[]  @relation("CampaignSender")

  @@map("users")
}

model Gym {
  id                   String             @id @default(uuid()) @db.Uuid
  name                 String
  timezone             String             @default("Asia/Kolkata")
  /// Maximum non-owner team accounts (active members + pending invites). Managed by Gecco, not by owners.
  seatLimit            Int                @default(5) @map("seat_limit")
  /// Email every owner a receipt and the day's collection whenever a payment is recorded.
  emailOwnersOnPayment Boolean            @default(true) @map("email_owners_on_payment")
  /// Email the member their receipt (with the PDF bill attached) when a payment is recorded.
  emailMemberReceipts  Boolean            @default(true) @map("email_member_receipts")
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  users                GymUser[]
  members              Member[]
  charges              MembershipCharge[]
  paymentModes         PaymentMode[]
  recipients           PaymentRecipient[]
  payments             Payment[]
  plans                Plan[]
  activeSessions       Session[]          @relation("SessionActiveGym")
  trainers             Trainer[]
  memberImports        MemberImport[]
  leads                Lead[]
  invites              GymInvite[]
  signupInvite         GymSignupInvite?
  campaigns            Campaign[]

  @@map("gyms")
}

model Session {
  id          String   @id @default(uuid()) @db.Uuid
  tokenHash   String   @unique @map("token_hash")
  userId      String   @map("user_id") @db.Uuid
  activeGymId String?  @map("active_gym_id") @db.Uuid
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  activeGym   Gym?     @relation("SessionActiveGym", fields: [activeGymId], references: [id])
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Single-use, short-lived link for setting a new password. Only the token's hash is stored.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

model GymUser {
  gymId       String      @map("gym_id") @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  role        GymUserRole
  /// Granted permission keys for non-owners; owners always have every permission.
  permissions String[]    @default([])
  memberScope MemberScope @default(ALL) @map("member_scope")
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at")
  gym         Gym         @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([gymId, userId])
  @@map("gym_users")
}

model GymInvite {
  id               String      @id @default(uuid()) @db.Uuid
  gymId            String      @map("gym_id") @db.Uuid
  tokenHash        String      @unique @map("token_hash")
  inviteeName      String?     @map("invitee_name")
  role             GymUserRole
  permissions      String[]    @default([])
  memberScope      MemberScope @default(ALL) @map("member_scope")
  trainerId        String?     @map("trainer_id") @db.Uuid
  invitedByUserId  String      @map("invited_by_user_id") @db.Uuid
  expiresAt        DateTime    @map("expires_at")
  acceptedAt       DateTime?   @map("accepted_at")
  acceptedByUserId String?     @map("accepted_by_user_id") @db.Uuid
  revokedAt        DateTime?   @map("revoked_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  gym              Gym         @relation(fields: [gymId], references: [id], onDelete: Cascade)
  trainer          Trainer?    @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  invitedBy        User        @relation("InviteSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedBy       User?       @relation("InviteAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([gymId, acceptedAt, revokedAt, expiresAt])
  @@map("gym_invites")
}

/// Single-use link the Gecco team issues so a new gym owner can create their workspace.
/// Only the token's hash is stored.
model GymSignupInvite {
  id              String    @id @default(uuid()) @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  /// Suggested gym name, editable by the owner during signup.
  gymName         String?   @map("gym_name")
  /// When set, only this email can use the link.
  email           String?
  seatLimit       Int       @default(5) @map("seat_limit")
  note            String?
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at")
  usedAt          DateTime? @map("used_at")
  revokedAt       DateTime? @map("revoked_at")
  gymId           String?   @unique @map("gym_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       User      @relation("SignupInviteCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  gym             Gym?      @relation(fields: [gymId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("gym_signup_invites")
}

model Trainer {
  id             String                        @id @default(uuid()) @db.Uuid
  gymId          String                        @map("gym_id") @db.Uuid
  userId         String?                       @map("user_id") @db.Uuid
  fullName       String
  isActive       Boolean                       @default(true)
  createdAt      DateTime                      @default(now()) @map("created_at")
  assignments    MembershipTrainerAssignment[]
  incentiveRules TrainerIncentiveRule[]
  invites        GymInvite[]
  gym            Gym                           @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([gymId, userId])
  @@index([gymId, isActive])
  @@map("trainers")
}

model TrainerIncentiveRule {
  id         String    @id @default(uuid()) @db.Uuid
  trainerId  String    @map("trainer_id") @db.Uuid
  percentage Decimal   @db.Decimal(5, 2)
  startsOn   DateTime  @map("starts_on") @db.Date
  endsOn     DateTime? @map("ends_on") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  trainer    Trainer   @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@unique([trainerId, startsOn])
  @@index([trainerId, startsOn, endsOn])
  @@map("trainer_incentive_rules")
}

model Member {
  id                 String              @id @default(uuid()) @db.Uuid
  gymId              String              @map("gym_id") @db.Uuid
  memberNumber       String              @map("member_number")
  fullName           String              @map("full_name")
  joinedOn           DateTime            @default(now()) @map("joined_on") @db.Date
  status             MemberRecordStatus  @default(ACTIVE)
  /// Set when the member asks not to receive campaign messages; campaigns skip them.
  messagingOptOutAt  DateTime?           @map("messaging_opt_out_at")
  /// Unguessable key for the member's private bills page, shared in receipt emails.
  billsToken         String              @unique @default(dbgenerated("(replace((gen_random_uuid())::text, '-'::text, ''::text) || replace((gen_random_uuid())::text, '-'::text, ''::text))")) @map("bills_token")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  contacts           MemberContact[]
  campaignRecipients CampaignRecipient[]
  notes              MemberNote[]
  gym                Gym                 @relation(fields: [gymId], references: [id], onDelete: Cascade)
  charges            MembershipCharge[]
  memberships        Membership[]
  payments           Payment[]
  convertedLead      Lead?

  @@unique([gymId, memberNumber])
  @@index([gymId, fullName])
  @@map("members")
}

model MemberContact {
  id        String      @id @default(uuid()) @db.Uuid
  memberId  String      @map("member_id") @db.Uuid
  kind      ContactKind
  value     String
  isPrimary Boolean     @default(false) @map("is_primary")
  createdAt DateTime    @default(now()) @map("created_at")
  member    Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, kind])
  @@map("member_contacts")
}

model MemberImport {
  id               String             @id @default(uuid()) @db.Uuid
  gymId            String             @map("gym_id") @db.Uuid
  createdByUserId  String             @map("created_by_user_id") @db.Uuid
  originalFileName String             @map("original_file_name")
  storageKey       String             @unique @map("storage_key")
  contentType      String             @map("content_type")
  fileSize         Int                @map("file_size")
  status           MemberImportStatus @default(UPLOADING)
  totalRows        Int                @default(0) @map("total_rows")
  processedRows    Int                @default(0) @map("processed_rows")
  validRows        Int                @default(0) @map("valid_rows")
  excludedRows     Int                @default(0) @map("excluded_rows")
  attempts         Int                @default(0)
  failureMessage   String?            @map("failure_message")
  startedAt        DateTime?          @map("started_at")
  completedAt      DateTime?          @map("completed_at")
  importedRows     Int                @default(0) @map("imported_rows")
  correctionForId  String?            @map("correction_for_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  gym              Gym                @relation(fields: [gymId], references: [id], onDelete: Cascade)
  createdBy        User               @relation(fields: [createdByUserId], references: [id])
  rows             MemberImportRow[]
  correctionFor    MemberImport?      @relation("ImportCorrections", fields: [correctionForId], references: [id])
  corrections      MemberImport[]     @relation("ImportCorrections")

  @@index([gymId, createdAt])
  @@index([status, createdAt])
  @@index([correctionForId])
  @@map("member_imports")
}

model MemberImportRow {
  id             String                @id @default(uuid()) @db.Uuid
  importId       String                @map("import_id") @db.Uuid
  rowNumber      Int                   @map("row_number")
  memberId       String?               @map("member_id")
  fullName       String?               @map("full_name")
  normalizedData Json                  @map("normalized_data")
  errors         Json
  status         MemberImportRowStatus
  createdAt      DateTime              @default(now()) @map("created_at")
  import         MemberImport          @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, rowNumber])
  @@index([importId, status, rowNumber])
  @@map("member_import_rows")
}

model MemberNote {
  id              String   @id @default(uuid()) @db.Uuid
  memberId        String   @map("member_id") @db.Uuid
  kind            NoteKind
  body            String
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  createdBy       User?    @relation("NoteAuthor", fields: [createdByUserId], references: [id])
  member          Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
  @@map("member_notes")
}

model Lead {
  id                 String              @id @default(uuid()) @db.Uuid
  gymId              String              @map("gym_id") @db.Uuid
  fullName           String              @map("full_name")
  phone              String?
  email              String?
  source             LeadSource          @default(OTHER)
  status             LeadStatus          @default(NEW)
  interestedPlan     PlanType?           @map("interested_plan")
  nextFollowUpAt     DateTime?           @map("next_follow_up_at")
  lastContactedAt    DateTime?           @map("last_contacted_at")
  lostReasonCode     LeadLostReason?     @map("lost_reason_code")
  lostReason         String?             @map("lost_reason")
  assignedToUserId   String?             @map("assigned_to_user_id") @db.Uuid
  trialAt            DateTime?           @map("trial_at")
  firstContactedAt   DateTime?           @map("first_contacted_at")
  convertedMemberId  String?             @unique @map("converted_member_id") @db.Uuid
  convertedAt        DateTime?           @map("converted_at")
  /// Set when the lead asks not to receive campaign messages; campaigns skip them.
  messagingOptOutAt  DateTime?           @map("messaging_opt_out_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  gym                Gym                 @relation(fields: [gymId], references: [id], onDelete: Cascade)
  convertedMember    Member?             @relation(fields: [convertedMemberId], references: [id], onDelete: SetNull)
  assignedTo         User?               @relation("LeadAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  activities         LeadActivity[]
  campaignRecipients CampaignRecipient[]

  @@index([gymId, status, updatedAt])
  @@index([gymId, nextFollowUpAt])
  @@index([gymId, fullName])
  @@index([gymId, trialAt])
  @@index([gymId, assignedToUserId])
  @@map("leads")
}

model LeadActivity {
  id              String           @id @default(uuid()) @db.Uuid
  leadId          String           @map("lead_id") @db.Uuid
  type            LeadActivityType
  body            String
  createdByUserId String?          @map("created_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")
  lead            Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy       User?            @relation("LeadActivityAuthor", fields: [createdByUserId], references: [id])

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

model Plan {
  id                     String       @id @default(uuid()) @db.Uuid
  gymId                  String       @map("gym_id") @db.Uuid
  code                   String
  name                   String
  type                   PlanType
  standardMonthlyFee     Decimal      @map("standard_monthly_fee") @db.Decimal(12, 2)
  durationMonths         Int          @default(1) @map("duration_months")
  requiresTrainer        Boolean      @default(false) @map("requires_trainer")
  trainerRevenueEligible Boolean      @default(false) @map("trainer_revenue_eligible")
  isActive               Boolean      @default(true) @map("is_active")
  createdAt              DateTime     @default(now()) @map("created_at")
  memberships            Membership[]
  gym                    Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([gymId, code])
  @@map("plans")
}

model Membership {
  id                             String                        @id @default(uuid()) @db.Uuid
  memberId                       String                        @map("member_id") @db.Uuid
  planId                         String                        @map("plan_id") @db.Uuid
  planTypeSnapshot               PlanType                      @map("plan_type_snapshot")
  trainerRevenueEligibleSnapshot Boolean                       @default(false) @map("trainer_revenue_eligible_snapshot")
  durationMonths                 Int                           @default(1) @map("duration_months")
  startsOn                       DateTime                      @map("starts_on") @db.Date
  endsOn                         DateTime                      @map("ends_on") @db.Date
  agreedFee                      Decimal                       @map("agreed_fee") @db.Decimal(12, 2)
  status                         MembershipStatus              @default(ACTIVE)
  renewedFromId                  String?                       @map("renewed_from_id") @db.Uuid
  createdAt                      DateTime                      @default(now()) @map("created_at")
  updatedAt                      DateTime                      @updatedAt @map("updated_at")
  incomingTransfers              MembershipBalanceTransfer[]   @relation("TransferDestination")
  outgoingTransfers              MembershipBalanceTransfer[]   @relation("TransferSource")
  charges                        MembershipCharge[]
  trainerAssignments             MembershipTrainerAssignment[]
  member                         Member                        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan                           Plan                          @relation(fields: [planId], references: [id])
  renewedFrom                    Membership?                   @relation("MembershipRenewal", fields: [renewedFromId], references: [id])
  renewals                       Membership[]                  @relation("MembershipRenewal")
  payments                       Payment[]

  @@index([memberId, status, endsOn])
  @@map("memberships")
}

model MembershipTrainerAssignment {
  id           String     @id @default(uuid()) @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  trainerId    String     @map("trainer_id") @db.Uuid
  startsOn     DateTime   @map("starts_on") @db.Date
  endsOn       DateTime?  @map("ends_on") @db.Date
  createdAt    DateTime   @default(now()) @map("created_at")
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  trainer      Trainer    @relation(fields: [trainerId], references: [id])

  @@index([membershipId, startsOn])
  @@map("membership_trainer_assignments")
}

model PaymentMode {
  id        String    @id @default(uuid()) @db.Uuid
  gymId     String    @map("gym_id") @db.Uuid
  name      String
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")
  gym       Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  payments  Payment[]

  @@unique([gymId, name])
  @@map("payment_modes")
}

model PaymentRecipient {
  id            String        @id @default(uuid()) @db.Uuid
  gymId         String        @map("gym_id") @db.Uuid
  displayName   String        @map("display_name")
  recipientType RecipientType @map("recipient_type")
  isActive      Boolean       @default(true) @map("is_active")
  gym           Gym           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  payments      Payment[]

  @@map("payment_recipients")
}

model Payment {
  id               String              @id @default(uuid()) @db.Uuid
  membershipId     String?             @map("membership_id") @db.Uuid
  amount           Decimal             @db.Decimal(12, 2)
  paidOn           DateTime            @map("paid_on") @db.Date
  paymentModeId    String              @map("payment_mode_id") @db.Uuid
  recipientId      String              @map("recipient_id") @db.Uuid
  status           PaymentStatus       @default(SUCCEEDED)
  reference        String?
  recordedByUserId String?             @map("recorded_by_user_id") @db.Uuid
  voidedAt         DateTime?           @map("voided_at")
  voidReason       String?             @map("void_reason")
  createdAt        DateTime            @default(now()) @map("created_at")
  gymId            String              @map("gym_id") @db.Uuid
  memberId         String              @map("member_id") @db.Uuid
  allocations      PaymentAllocation[]
  gym              Gym                 @relation(fields: [gymId], references: [id])
  member           Member              @relation(fields: [memberId], references: [id])
  membership       Membership?         @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  paymentMode      PaymentMode         @relation(fields: [paymentModeId], references: [id])
  recipient        PaymentRecipient    @relation(fields: [recipientId], references: [id])
  recordedBy       User?               @relation("PaymentRecorder", fields: [recordedByUserId], references: [id])

  @@index([membershipId, paidOn])
  @@index([gymId, memberId, paidOn])
  @@map("payments")
}

model MembershipCharge {
  id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gymId        String                 @map("gym_id") @db.Uuid
  memberId     String                 @map("member_id") @db.Uuid
  membershipId String                 @map("membership_id") @db.Uuid
  kind         MembershipChargeKind
  amount       Decimal                @db.Decimal(12, 2)
  dueOn        DateTime               @map("due_on") @db.Date
  status       MembershipChargeStatus @default(OPEN)
  description  String?
  voidedAt     DateTime?              @map("voided_at")
  createdAt    DateTime               @default(now()) @map("created_at")
  gym          Gym                    @relation(fields: [gymId], references: [id])
  member       Member                 @relation(fields: [memberId], references: [id])
  membership   Membership             @relation(fields: [membershipId], references: [id])
  allocations  PaymentAllocation[]

  @@index([gymId, status, dueOn])
  @@index([memberId, status])
  @@index([membershipId])
  @@map("membership_charges")
}

model PaymentAllocation {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId String           @map("payment_id") @db.Uuid
  chargeId  String           @map("charge_id") @db.Uuid
  amount    Decimal          @db.Decimal(12, 2)
  createdAt DateTime         @default(now()) @map("created_at")
  charge    MembershipCharge @relation(fields: [chargeId], references: [id])
  payment   Payment          @relation(fields: [paymentId], references: [id])

  @@unique([paymentId, chargeId])
  @@index([chargeId])
  @@map("payment_allocations")
}

model MembershipBalanceTransfer {
  id                      String     @id @default(uuid()) @db.Uuid
  sourceMembershipId      String     @map("source_membership_id") @db.Uuid
  destinationMembershipId String     @map("destination_membership_id") @db.Uuid
  amount                  Decimal    @db.Decimal(12, 2)
  transferredAt           DateTime   @default(now()) @map("transferred_at")
  createdByUserId         String?    @map("created_by_user_id") @db.Uuid
  destinationMembership   Membership @relation("TransferDestination", fields: [destinationMembershipId], references: [id])
  sourceMembership        Membership @relation("TransferSource", fields: [sourceMembershipId], references: [id])

  @@index([sourceMembershipId])
  @@index([destinationMembershipId])
  @@map("membership_balance_transfers")
}

/// A one-off message to a segment of members or leads. The audience is resolved
/// and snapshotted into recipients when the campaign is created.
model Campaign {
  id              String              @id @default(uuid()) @db.Uuid
  gymId           String              @map("gym_id") @db.Uuid
  name            String
  segment         CampaignSegment
  /// Segment options at creation time, e.g. { "days": 7 }.
  segmentParams   Json                @default("{}") @map("segment_params")
  /// Message with {{variable}} placeholders; each recipient stores the rendered text.
  messageTemplate String              @map("message_template")
  channel         CampaignChannel     @default(WHATSAPP_ASSISTED)
  status          CampaignStatus      @default(ACTIVE)
  /// Payments, renewals, and conversions within this many days of a send are credited to the campaign.
  attributionDays Int                 @default(7) @map("attribution_days")
  createdByUserId String?             @map("created_by_user_id") @db.Uuid
  completedAt     DateTime?           @map("completed_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  gym             Gym                 @relation(fields: [gymId], references: [id], onDelete: Cascade)
  createdBy       User?               @relation("CampaignCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  recipients      CampaignRecipient[]

  @@index([gymId, createdAt])
  @@map("campaigns")
}

model CampaignRecipient {
  id           String                  @id @default(uuid()) @db.Uuid
  campaignId   String                  @map("campaign_id") @db.Uuid
  memberId     String?                 @map("member_id") @db.Uuid
  leadId       String?                 @map("lead_id") @db.Uuid
  fullName     String                  @map("full_name")
  /// WhatsApp number as digits with country code, e.g. 919876543210.
  phone        String
  message      String
  /// Values substituted into the template, kept for reference.
  variables    Json                    @default("{}")
  status       CampaignRecipientStatus @default(PENDING)
  sentAt       DateTime?               @map("sent_at")
  sentByUserId String?                 @map("sent_by_user_id") @db.Uuid
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")
  campaign     Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  member       Member?                 @relation(fields: [memberId], references: [id], onDelete: SetNull)
  lead         Lead?                   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  sentBy       User?                   @relation("CampaignSender", fields: [sentByUserId], references: [id], onDelete: SetNull)

  @@index([campaignId, status])
  @@index([memberId, sentAt])
  @@index([leadId, sentAt])
  @@map("campaign_recipients")
}

view MemberBalanceSummary {
  gymId            String    @map("gym_id") @db.Uuid
  memberId         String    @map("member_id") @db.Uuid
  totalOutstanding Decimal   @map("total_outstanding") @db.Decimal(12, 2)
  overdueAmount    Decimal   @map("overdue_amount") @db.Decimal(12, 2)
  availableCredit  Decimal   @map("available_credit") @db.Decimal(12, 2)
  oldestDueOn      DateTime? @map("oldest_due_on") @db.Date
  paymentState     String    @map("payment_state")

  @@map("member_balance_summary")
}

