generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  authSubject  String       @unique
  fullName     String
  email        String       @unique
  createdAt    DateTime     @default(now()) @map("created_at")
  passwordHash String?      @map("password_hash")
  gymUsers     GymUser[]
  notes        MemberNote[] @relation("NoteAuthor")
  payments     Payment[]    @relation("PaymentRecorder")
  sessions     Session[]

  @@map("users")
}

model Gym {
  id             String             @id @default(uuid()) @db.Uuid
  name           String
  timezone       String             @default("Asia/Kolkata")
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  users          GymUser[]
  members        Member[]
  charges        MembershipCharge[]
  paymentModes   PaymentMode[]
  recipients     PaymentRecipient[]
  payments       Payment[]
  plans          Plan[]
  activeSessions Session[]          @relation("SessionActiveGym")
  trainers       Trainer[]

  @@map("gyms")
}

model Session {
  id          String   @id @default(uuid()) @db.Uuid
  tokenHash   String   @unique @map("token_hash")
  userId      String   @map("user_id") @db.Uuid
  activeGymId String?  @map("active_gym_id") @db.Uuid
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  activeGym   Gym?     @relation("SessionActiveGym", fields: [activeGymId], references: [id])
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model GymUser {
  gymId     String      @map("gym_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  role      GymUserRole
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now()) @map("created_at")
  gym       Gym         @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([gymId, userId])
  @@map("gym_users")
}

model Trainer {
  id          String                        @id @default(uuid()) @db.Uuid
  gymId       String                        @map("gym_id") @db.Uuid
  userId      String?                       @unique @map("user_id") @db.Uuid
  fullName    String
  isActive    Boolean                       @default(true)
  createdAt   DateTime                      @default(now()) @map("created_at")
  assignments MembershipTrainerAssignment[]
  gym         Gym                           @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId, isActive])
  @@map("trainers")
}

model Member {
  id           String             @id @default(uuid()) @db.Uuid
  gymId        String             @map("gym_id") @db.Uuid
  memberNumber String             @map("member_number")
  fullName     String             @map("full_name")
  joinedOn     DateTime           @default(now()) @map("joined_on") @db.Date
  status       MemberRecordStatus @default(ACTIVE)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  contacts     MemberContact[]
  notes        MemberNote[]
  gym          Gym                @relation(fields: [gymId], references: [id], onDelete: Cascade)
  charges      MembershipCharge[]
  memberships  Membership[]
  payments     Payment[]

  @@unique([gymId, memberNumber])
  @@index([gymId, fullName])
  @@map("members")
}

model MemberContact {
  id        String      @id @default(uuid()) @db.Uuid
  memberId  String      @map("member_id") @db.Uuid
  kind      ContactKind
  value     String
  isPrimary Boolean     @default(false) @map("is_primary")
  createdAt DateTime    @default(now()) @map("created_at")
  member    Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, kind])
  @@map("member_contacts")
}

model MemberNote {
  id              String   @id @default(uuid()) @db.Uuid
  memberId        String   @map("member_id") @db.Uuid
  kind            NoteKind
  body            String
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  createdBy       User?    @relation("NoteAuthor", fields: [createdByUserId], references: [id])
  member          Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
  @@map("member_notes")
}

model Plan {
  id                 String       @id @default(uuid()) @db.Uuid
  gymId              String       @map("gym_id") @db.Uuid
  code               String
  name               String
  type               PlanType
  standardMonthlyFee Decimal      @map("standard_monthly_fee") @db.Decimal(12, 2)
  isActive           Boolean      @default(true) @map("is_active")
  createdAt          DateTime     @default(now()) @map("created_at")
  memberships        Membership[]
  gym                Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([gymId, code])
  @@map("plans")
}

model Membership {
  id                 String                        @id @default(uuid()) @db.Uuid
  memberId           String                        @map("member_id") @db.Uuid
  planId             String                        @map("plan_id") @db.Uuid
  planTypeSnapshot   PlanType                      @map("plan_type_snapshot")
  startsOn           DateTime                      @map("starts_on") @db.Date
  endsOn             DateTime                      @map("ends_on") @db.Date
  agreedFee          Decimal                       @map("agreed_fee") @db.Decimal(12, 2)
  status             MembershipStatus              @default(ACTIVE)
  renewedFromId      String?                       @map("renewed_from_id") @db.Uuid
  createdAt          DateTime                      @default(now()) @map("created_at")
  updatedAt          DateTime                      @updatedAt @map("updated_at")
  incomingTransfers  MembershipBalanceTransfer[]   @relation("TransferDestination")
  outgoingTransfers  MembershipBalanceTransfer[]   @relation("TransferSource")
  charges            MembershipCharge[]
  trainerAssignments MembershipTrainerAssignment[]
  member             Member                        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan               Plan                          @relation(fields: [planId], references: [id])
  renewedFrom        Membership?                   @relation("MembershipRenewal", fields: [renewedFromId], references: [id])
  renewals           Membership[]                  @relation("MembershipRenewal")
  payments           Payment[]

  @@index([memberId, status, endsOn])
  @@map("memberships")
}

model MembershipTrainerAssignment {
  id           String     @id @default(uuid()) @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  trainerId    String     @map("trainer_id") @db.Uuid
  startsOn     DateTime   @map("starts_on") @db.Date
  endsOn       DateTime?  @map("ends_on") @db.Date
  createdAt    DateTime   @default(now()) @map("created_at")
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  trainer      Trainer    @relation(fields: [trainerId], references: [id])

  @@index([membershipId, startsOn])
  @@map("membership_trainer_assignments")
}

model PaymentMode {
  id        String    @id @default(uuid()) @db.Uuid
  gymId     String    @map("gym_id") @db.Uuid
  name      String
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")
  gym       Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  payments  Payment[]

  @@unique([gymId, name])
  @@map("payment_modes")
}

model PaymentRecipient {
  id            String        @id @default(uuid()) @db.Uuid
  gymId         String        @map("gym_id") @db.Uuid
  displayName   String        @map("display_name")
  recipientType RecipientType @map("recipient_type")
  isActive      Boolean       @default(true) @map("is_active")
  gym           Gym           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  payments      Payment[]

  @@map("payment_recipients")
}

model Payment {
  id               String              @id @default(uuid()) @db.Uuid
  membershipId     String?             @map("membership_id") @db.Uuid
  amount           Decimal             @db.Decimal(12, 2)
  paidOn           DateTime            @map("paid_on") @db.Date
  paymentModeId    String              @map("payment_mode_id") @db.Uuid
  recipientId      String              @map("recipient_id") @db.Uuid
  status           PaymentStatus       @default(SUCCEEDED)
  reference        String?
  recordedByUserId String?             @map("recorded_by_user_id") @db.Uuid
  voidedAt         DateTime?           @map("voided_at")
  voidReason       String?             @map("void_reason")
  createdAt        DateTime            @default(now()) @map("created_at")
  gymId            String              @map("gym_id") @db.Uuid
  memberId         String              @map("member_id") @db.Uuid
  allocations      PaymentAllocation[]
  gym              Gym                 @relation(fields: [gymId], references: [id])
  member           Member              @relation(fields: [memberId], references: [id])
  membership       Membership?         @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  paymentMode      PaymentMode         @relation(fields: [paymentModeId], references: [id])
  recipient        PaymentRecipient    @relation(fields: [recipientId], references: [id])
  recordedBy       User?               @relation("PaymentRecorder", fields: [recordedByUserId], references: [id])

  @@index([membershipId, paidOn])
  @@index([gymId, memberId, paidOn])
  @@map("payments")
}

model MembershipCharge {
  id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gymId        String                 @map("gym_id") @db.Uuid
  memberId     String                 @map("member_id") @db.Uuid
  membershipId String                 @map("membership_id") @db.Uuid
  kind         MembershipChargeKind
  amount       Decimal                @db.Decimal(12, 2)
  dueOn        DateTime               @map("due_on") @db.Date
  status       MembershipChargeStatus @default(OPEN)
  description  String?
  voidedAt     DateTime?              @map("voided_at")
  createdAt    DateTime               @default(now()) @map("created_at")
  gym          Gym                    @relation(fields: [gymId], references: [id])
  member       Member                 @relation(fields: [memberId], references: [id])
  membership   Membership             @relation(fields: [membershipId], references: [id])
  allocations  PaymentAllocation[]

  @@index([gymId, status, dueOn])
  @@index([memberId, status])
  @@index([membershipId])
  @@map("membership_charges")
}

model PaymentAllocation {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId String           @map("payment_id") @db.Uuid
  chargeId  String           @map("charge_id") @db.Uuid
  amount    Decimal          @db.Decimal(12, 2)
  createdAt DateTime         @default(now()) @map("created_at")
  charge    MembershipCharge @relation(fields: [chargeId], references: [id])
  payment   Payment          @relation(fields: [paymentId], references: [id])

  @@unique([paymentId, chargeId])
  @@index([chargeId])
  @@map("payment_allocations")
}

model MembershipBalanceTransfer {
  id                      String     @id @default(uuid()) @db.Uuid
  sourceMembershipId      String     @map("source_membership_id") @db.Uuid
  destinationMembershipId String     @map("destination_membership_id") @db.Uuid
  amount                  Decimal    @db.Decimal(12, 2)
  transferredAt           DateTime   @default(now()) @map("transferred_at")
  createdByUserId         String?    @map("created_by_user_id") @db.Uuid
  destinationMembership   Membership @relation("TransferDestination", fields: [destinationMembershipId], references: [id])
  sourceMembership        Membership @relation("TransferSource", fields: [sourceMembershipId], references: [id])

  @@index([sourceMembershipId])
  @@index([destinationMembershipId])
  @@map("membership_balance_transfers")
}

view MemberBalanceSummary {
  gymId           String    @map("gym_id") @db.Uuid
  memberId        String    @map("member_id") @db.Uuid
  totalOutstanding Decimal   @map("total_outstanding") @db.Decimal(12, 2)
  overdueAmount   Decimal   @map("overdue_amount") @db.Decimal(12, 2)
  availableCredit Decimal   @map("available_credit") @db.Decimal(12, 2)
  oldestDueOn     DateTime? @map("oldest_due_on") @db.Date
  paymentState    String    @map("payment_state")

  @@map("member_balance_summary")
}

enum GymUserRole {
  OWNER
  STAFF
  TRAINER
}

enum MemberRecordStatus {
  ACTIVE
  ARCHIVED
}

enum PlanType {
  GT
  PT
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ContactKind {
  PHONE
  EMAIL
  WHATSAPP
  OTHER
}

enum NoteKind {
  REMARK
  FEEDBACK
}

enum PaymentStatus {
  SUCCEEDED
  VOIDED
  REFUNDED
}

enum MembershipChargeKind {
  MEMBERSHIP_FEE
  RENEWAL
  ADD_ON
  ADJUSTMENT
}

enum MembershipChargeStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  VOIDED
}

enum RecipientType {
  GYM
  TRAINER
  OTHER
}
