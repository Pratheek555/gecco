DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
R2_BUCKET_NAME="gecco-member-imports"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"

IMPORT_WORKER_URL="https://gecco-member-imports.YOUR_SUBDOMAIN.workers.dev"
IMPORT_WORKER_SECRET="use-the-same-long-random-secret-as-the-worker"

# Gecco staff (comma separated) who can issue gym signup links at /admin/gyms.
# Only list emails that already have an account.
PLATFORM_ADMIN_EMAILS="founder@gecco.in"

# Password reset emails (sent via Resend). Without a key, dev logs the reset link to the console.
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="Gecco <no-reply@gecco.in>"
# Public dashboard origin used in emailed links, e.g. https://app.gecco.in
APP_URL="http://localhost:3001"
