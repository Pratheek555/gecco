{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gecco-member-imports",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-07",
  "triggers": {
    "crons": ["0 2 * * *"],
  },
  "r2_buckets": [{ "binding": "MEMBER_IMPORTS", "bucket_name": "gecco" }],
  "queues": {
    "producers": [{ "binding": "IMPORT_QUEUE", "queue": "gecco-member-imports" }],
    "consumers": [
      {
        "queue": "gecco-member-imports",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "gecco-member-imports-dlq",
      },
    ],
  },
}
