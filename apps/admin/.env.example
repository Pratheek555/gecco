# Same database as the customer dashboard.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Gecco staff (comma separated) allowed into Gecco HQ. Only list emails that already have an account.
PLATFORM_ADMIN_EMAILS="founder@gecco.in"

# Signs the HQ session cookie. Use a long random value, e.g. `openssl rand -base64 48`.
ADMIN_SESSION_SECRET="use-a-long-random-secret"

# Public origin of the customer dashboard, used to build gym signup links.
DASHBOARD_URL="https://app.gecco.in"

# Local design work only: render the console from built-in sample data, without a database or login.
# Ignored in production builds.
# ADMIN_SAMPLE_DATA="1"
