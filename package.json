{
  "name": "gecco",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:website": "turbo dev --filter=@gecco/website",
    "dev:dashboard": "turbo dev --filter=@gecco/dashboard",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.10.10"
  }
}
